# Copy to .env for local Compose runs. .env is gitignored; .env.example is not.
# These are DEVELOPMENT defaults only — never use them anywhere real.

POSTGRES_DB=anomaly
POSTGRES_USER=anomaly
POSTGRES_PASSWORD=anomaly_dev_only
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=5173
JWT_SECRET=change_me_dev_only

VITE_API_BASE_URL=http://localhost:8000/api/v1

# Ollama runs on the host, not in Compose (it needs the GPU).
# The API is designed to start healthy without it.
OLLAMA_BASE_URL=http://host.docker.internal:11434
